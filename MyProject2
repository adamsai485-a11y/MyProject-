--==================================================
-- AUTO GUN LOOP
--==================================================

task.spawn(function()
	while running do

		if isAutoGunEnabled then

			local character = getCharacter()
			local rootPart = getRootPart(character)

			if rootPart then

				local gunPart = findGunDrop()

				if gunPart and gunPart.Parent then

					infoLabel.Text =
						"Оружие: GunDrop найден"

					moveToPickup(
						rootPart,
						gunPart
					)

					task.wait(0.15)

				else
					infoLabel.Text =
						"Оружие: GunDrop не найден"

					task.wait(0.30)
				end

			else
				infoLabel.Text =
					"Оружие: персонаж не готов"

				task.wait(0.30)
			end

		else
			task.wait(0.20)
		end
	end
end)

--==================================================
-- COIN FARM LOOP
--==================================================

task.spawn(function()
	while running do

		if isCoinFarmEnabled and not isAutoGunEnabled then

			local character = getCharacter()
			local rootPart = getRootPart(character)

			if rootPart then

				local container = findCoinContainer()

				if not container then

					infoLabel.Text =
						"Монеты: CoinContainer не найден"

					task.wait(0.50)

				else

					local coinPart, distance =
						findNearestCoin(rootPart)

					if coinPart and coinPart.Parent then

						infoLabel.Text =
							string.format(
								"Монеты: найдена (%.0f studs)",
								distance
							)

						moveToPickup(
							rootPart,
							coinPart
						)

						task.wait(0.12)

					else
						infoLabel.Text =
							"Монеты: активных монет нет"

						task.wait(0.35)
					end
				end

			else
				infoLabel.Text =
					"Монеты: персонаж не готов"

				task.wait(0.35)
			end

		else
			task.wait(0.20)
		end
	end
end)

