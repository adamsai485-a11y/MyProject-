-- ОСНОВНОЙ ЦИКЛ
--==================================================

RunService.Heartbeat:Connect(function()
	scanRoles()
	updateHeroStatus()

	local character = LocalPlayer.Character
	if not character then return end
	local rootPart = getRootPart(character)
	if not rootPart then return end

	if isAutoGunEnabled then
		for _, obj in ipairs(Workspace:GetChildren()) do
			if obj.Name == "GunDrop" and obj:IsA("BasePart") then
				rootPart.CFrame = obj.CFrame + Vector3.new(0, 2, 0)
				break
			end
		end
	end

	if isCoinFarmEnabled then
		local coinContainer = Workspace:FindFirstChild("CoinContainer") or Workspace:FindFirstChild("Coins")
		if coinContainer then
			for _, coin in ipairs(coinContainer:GetChildren()) do
				local coinPart = coin:FindFirstChild("CoinVisual") or coin:FindFirstChild("Part") or (coin:IsA("BasePart") and coin)
				if coinPart and isCoinFarmEnabled then
					rootPart.CFrame = coinPart.CFrame
					task.wait(0.15)
					break
				end
			end
		end
	end
end)

