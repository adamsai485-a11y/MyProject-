--==================================================
-- BASIC HELPERS
--==================================================

local function getCharacter()
	return LocalPlayer.Character
end

local function getRootPart(character)
	if not character then
		return nil
	end

	local root = character:FindFirstChild("HumanoidRootPart")

	if root and root:IsA("BasePart") then
		return root
	end

	return nil
end

local function isValid(instance)
	return instance ~= nil
		and instance.Parent ~= nil
end

--==================================================
-- TOUCH SUPPORT
--==================================================

local function hasTouchSupport()
	return type(firetouchinterest) == "function"
end

local function fireTouch(rootPart, targetPart)
	if not rootPart or not targetPart then
		return false
	end

	if not hasTouchSupport() then
		return false
	end

	local success = pcall(function()
		firetouchinterest(rootPart, targetPart, 0)
		task.wait(0.03)
		firetouchinterest(rootPart, targetPart, 1)
	end)

	return success
end

--==================================================
-- MAP / COIN CONTAINER
--==================================================

local function findCoinContainer()
	-- Основной вариант:
	-- CoinContainer находится внутри текущей карты.
	local container = Workspace:FindFirstChild("CoinContainer", true)

	if container then
		return container
	end

	-- Запасной вариант для другой структуры.
	container = Workspace:FindFirstChild("Coins", true)

	if container then
		return container
	end

	return nil
end

--==================================================
-- COIN PICKUP PART
--==================================================

local function getCoinPickupPart(coin)
	if not coin then
		return nil
	end

	-- Стандартная структура MM2:
	-- Coin = BasePart
	-- TouchInterest + CoinVisual
	if coin:IsA("BasePart") then
		local touch = coin:FindFirstChild("TouchInterest")
		local visual = coin:FindFirstChild("CoinVisual")

		if touch and visual then
			return coin
		end

		-- Иногда достаточно одного TouchInterest.
		if touch then
			return coin
		end
	end

	-- Запасной поиск внутри модели.
	for _, obj in ipairs(coin:GetDescendants()) do
		if obj:IsA("BasePart") then
			if obj:FindFirstChild("TouchInterest") then
				return obj
			end
		end
	end

	return nil
end

--==================================================
-- CHECK ACTIVE COIN
--==================================================

local function isCoinActive(coin)
	if not coin or not coin.Parent then
		return false
	end

	local visual = coin:FindFirstChild("CoinVisual", true)

	if visual and visual:IsA("BasePart") then
		if visual.Transparency >= 0.99 then
			return false
		end
	end

	return true
end

--==================================================
-- FIND NEAREST COIN
--==================================================

local function findNearestCoin(rootPart)
	local container = findCoinContainer()

	if not container or not rootPart then
		return nil, nil
	end

	local nearestCoin = nil
	local nearestDistance = math.huge

	for _, coin in ipairs(container:GetChildren()) do
		if isCoinActive(coin) then

			local pickupPart = getCoinPickupPart(coin)

			if pickupPart and pickupPart.Parent then
				local distance =
					(rootPart.Position - pickupPart.Position).Magnitude

				if distance < nearestDistance then
					nearestDistance = distance
					nearestCoin = pickupPart
				end
			end
		end
	end

	return nearestCoin, nearestDistance
end

--==================================================
-- GUN DROP
--==================================================

local function findGunDrop()
	-- Основной MM2 объект.
	local gun = Workspace:FindFirstChild("GunDrop", true)

	if gun then
		if gun:IsA("BasePart") then
			return gun
		end

		local part = gun:FindFirstChildWhichIsA("BasePart", true)

		if part then
			return part
		end
	end

	-- Запасной вариант.
	local droppedGun = Workspace:FindFirstChild("DroppedGun", true)

	if droppedGun then
		if droppedGun:IsA("BasePart") then
			return droppedGun
		end

		local part = droppedGun:FindFirstChildWhichIsA(
			"BasePart",
			true
		)

		if part then
			return part
		end
	end

	return nil
end

--==================================================
-- MOVE TO PICKUP
--==================================================

local function moveToPickup(rootPart, targetPart)
	if not rootPart or not targetPart then
		return false
	end

	if not targetPart.Parent then
		return false
	end

	pcall(function()
		rootPart.AssemblyLinearVelocity = Vector3.zero
		rootPart.AssemblyAngularVelocity = Vector3.zero
	end)

	-- Сначала перемещаем персонажа к объекту.
	rootPart.CFrame = targetPart.CFrame

	-- Небольшая пауза для обновления состояния.
	task.wait(0.03)

	-- Затем явно вызываем touch, если executor это поддерживает.
	fireTouch(rootPart, targetPart)

	return true
end

--==================================================
-- ROLE DETECTION
--==================================================

local function hasItem(player, itemName)
	if not player then
		return false
	end

	local character = player.Character
	local backpack = player:FindFirstChildOfClass("Backpack")

	if character and character:FindFirstChild(itemName) then
		return true
	end

	if backpack and backpack:FindFirstChild(itemName) then
		return true
	end

	return false
end

local lastMurderer = ""
local lastSheriff = ""
local lastGunState = false

local function scanRoles()
	local murderer = "Неизвестно"
	local sheriff = "Неизвестно"

	for _, player in ipairs(Players:GetPlayers()) do

		if hasItem(player, "Knife") then
			murderer = player.Name
		end

		if hasItem(player, "Gun") then
			sheriff = player.Name
		end
	end

	local gunDrop = findGunDrop()
	local gunDropped = gunDrop ~= nil

	if murderer ~= lastMurderer then
		lastMurderer = murderer
		murdererLabel.Text = "Убийца: " .. murderer
	end

	if sheriff ~= lastSheriff then
		lastSheriff = sheriff
		sheriffLabel.Text = "Шериф: " .. sheriff
	end

	if gunDropped ~= lastGunState then
		lastGunState = gunDropped

		if gunDropped then
			gunLabel.Text = "Оружие на полу: ДА"
			gunLabel.TextColor3 =
				Color3.fromRGB(80, 255, 80)
		else
			gunLabel.Text = "Оружие на полу: Нет"
			gunLabel.TextColor3 =
				Color3.fromRGB(255, 200, 50)
		end
	end
end

