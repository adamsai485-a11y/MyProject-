local function setSmoothnessFromX(x)
	local left = sliderBackground.AbsolutePosition.X
	local width = sliderBackground.AbsoluteSize.X

	if width <= 0 then
		return
	end

	local percent = math.clamp(
		(x - left) / width,
		0,
		1
	)

	aimSmoothness = math.floor(percent * 100 + 0.5)

	sliderFill.Size =
		UDim2.new(aimSmoothness / 100, 0, 1, 0)

	sliderKnob.Position =
		UDim2.new(aimSmoothness / 100, 0, 0.5, 0)

	smoothnessLabel.Text =
		"Плавность: " .. aimSmoothness .. "%"
end

