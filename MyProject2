--==================================================
-- CLEANUP
--==================================================

local function cleanup()
	if not running then
		return
	end

	running = false

	isCoinFarmEnabled = false
	isAutoGunEnabled = false

	for _, connection in ipairs(connections) do
		if connection and connection.Connected then
			connection:Disconnect()
		end
	end

	table.clear(connections)

	if ENV.MM2UtilityCleanup == cleanup then
		ENV.MM2UtilityCleanup = nil
	end

	if screenGui and screenGui.Parent then
		screenGui:Destroy()
	end
end

ENV.MM2UtilityCleanup = cleanup

connect(screenGui.AncestryChanged, function(_, parent)
	if parent == nil and running then
		cleanup()
	end
end)

--==================================================
-- ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
--==================================================

local function getRootPart(character)
	if not character then
		return nil
	end

	local root = character:FindFirstChild("HumanoidRootPart")

	if root and root:IsA("BasePart") then
		return root
	end

	return nil
end

local function hasItem(player, itemName)
	if not player then
		return false
	end

	local character = player.Character
	local backpack = player:FindFirstChildOfClass("Backpack")

	if character and character:FindFirstChild(itemName) then
		return true
	end

	if backpack and backpack:FindFirstChild(itemName) then
		return true
	end

	return false
end

local function getObjectPart(object)
	if not object then
		return nil
	end

	if object:IsA("BasePart") then
		return object
	end

	return object:FindFirstChildWhichIsA("BasePart", true)
end

--==================================================
-- ПОИСК GUN DROP
--==================================================

local function findGunDrop()
	for _, object in ipairs(Workspace:GetChildren()) do
		if object.Name == "GunDrop" then
			local part = getObjectPart(object)

			if part then
				return part
			end
		end
	end

	return nil
end

--==================================================
-- ПОИСК КОНТЕЙНЕРА МОНЕТ
--==================================================

local function findCoinContainer()
	return Workspace:FindFirstChild("CoinContainer")
		or Workspace:FindFirstChild("Coins")
end

--==================================================
-- ПОИСК ЧАСТИ МОНЕТЫ
--==================================================

local function getCoinPart(coin)
	if not coin then
		return nil
	end

	if coin:IsA("BasePart") then
		return coin
	end

	local coinVisual = coin:FindFirstChild("CoinVisual", true)

	if coinVisual and coinVisual:IsA("BasePart") then
		return coinVisual
	end

	local part = coin:FindFirstChild("Part", true)

	if part and part:IsA("BasePart") then
		return part
	end

	return coin:FindFirstChildWhichIsA("BasePart", true)
end

--==================================================
-- ПОИСК БЛИЖАЙШЕЙ МОНЕТЫ
--==================================================

local coinCooldown = {}

local function findNearestCoin(rootPart)
	local container = findCoinContainer()

	if not container or not rootPart then
		return nil
	end

	local nearestPart = nil
	local nearestDistance = math.huge
	local now = os.clock()

	for _, coin in ipairs(container:GetChildren()) do
		local cooldownUntil = coinCooldown[coin]

		if not cooldownUntil or cooldownUntil <= now then
			local coinPart = getCoinPart(coin)

			if coinPart and coinPart.Parent then
				local distance = (rootPart.Position - coinPart.Position).Magnitude

				if distance < nearestDistance then
					nearestDistance = distance
					nearestPart = coinPart
				end
			end
		end
	end

	return nearestPart
end

--==================================================
-- СКАНИРОВАНИЕ РОЛЕЙ
--==================================================

local lastMurderer = nil
local lastSheriff = nil
local lastGunDropped = nil

local function scanRoles()
	local murderer = "Неизвестно"
	local sheriff = "Неизвестно"

	for _, player in ipairs(Players:GetPlayers()) do
		if hasItem(player, "Knife") then
			murderer = player.Name
		end

		if hasItem(player, "Gun") then
			sheriff = player.Name
		end
	end

	local gunDropped = findGunDrop() ~= nil

	if murderer ~= lastMurderer then
		lastMurderer = murderer
		murdererLabel.Text = "Убийца: " .. murderer
	end

	if sheriff ~= lastSheriff then
		lastSheriff = sheriff
		sheriffLabel.Text = "Шериф: " .. sheriff
	end

	if gunDropped ~= lastGunDropped then
		lastGunDropped = gunDropped

		if gunDropped then
			heroLabel.Text = "Оружие на полу: ДА"
			heroLabel.TextColor3 = Color3.fromRGB(80, 255, 80)
		else
			heroLabel.Text = "Оружие на полу: Нет"
			heroLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
		end
	end
end

