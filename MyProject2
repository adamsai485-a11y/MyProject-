--==================================================
-- AUTO GUN
--==================================================

task.spawn(function()
	while running do
		if isAutoGunEnabled then
			local character = LocalPlayer.Character
			local rootPart = getRootPart(character)

			if rootPart then
				local gunPart = findGunDrop()

				if gunPart then
					rootPart.CFrame = gunPart.CFrame + Vector3.new(0, 2, 0)
				end
			end
		end

		task.wait(0.20)
	end
end)

--==================================================
-- COIN FARM
--==================================================

task.spawn(function()
	while running do
		if isCoinFarmEnabled and not isAutoGunEnabled then
			local character = LocalPlayer.Character
			local rootPart = getRootPart(character)

			if rootPart then
				local coinPart = findNearestCoin(rootPart)

				if coinPart and coinPart.Parent then
					rootPart.CFrame = coinPart.CFrame + Vector3.new(0, 1.5, 0)

					local coinObject = coinPart.Parent
					coinCooldown[coinObject] = os.clock() + 0.35
				end
			end
		end

		task.wait(0.18)
	end
end)

--==================================================
-- ROLE SCANNER
--==================================================

task.spawn(function()
	while running do
		scanRoles()
		task.wait(0.50)
	end
end)

