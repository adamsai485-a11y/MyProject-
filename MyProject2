local lastMurderer = ""
local lastSheriff = ""
local lastGunDrop = false

local function scanRoles()
	local murderer = "Неизвестно"
	local sheriff = "Неизвестно"

	for _, player in ipairs(Players:GetPlayers()) do

		if hasItem(player, "Knife") then
			murderer = player.Name
		end

		if hasItem(player, "Gun") then
			sheriff = player.Name
		end
	end

	local gunDropped =
		findGunDrop() ~= nil

	if murderer ~= lastMurderer then
		lastMurderer = murderer
		murdererLabel.Text =
			"Убийца: " .. murderer
	end

	if sheriff ~= lastSheriff then
		lastSheriff = sheriff
		sheriffLabel.Text =
			"Шериф: " .. sheriff
	end

	if gunDropped ~= lastGunDrop then
		lastGunDrop = gunDropped

		if gunDropped then
			heroLabel.Text =
				"Оружие на полу: ДА"

			heroLabel.TextColor3 =
				Color3.fromRGB(80, 255, 80)
		else
			heroLabel.Text =
				"Оружие на полу: Нет"

			heroLabel.TextColor3 =
				Color3.fromRGB(255, 200, 50)
		end
	end
end

