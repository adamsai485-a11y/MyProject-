local function hasTouchAPI()
	return type(firetouchinterest) == "function"
end

local function fireTouch(rootPart, targetPart)
	if not rootPart or not targetPart then
		return false
	end

	if not hasTouchAPI() then
		return false
	end

	local success = pcall(function()
		firetouchinterest(rootPart, targetPart, 0)
		task.wait(0.03)
		firetouchinterest(rootPart, targetPart, 1)
	end)

	return success
end

--==================================================
-- GUN DROP
--==================================================

local function findGunDrop()
	local gun = Workspace:FindFirstChild("GunDrop", true)

	if gun then
		if gun:IsA("BasePart") then
			return gun
		end

		local part = gun:FindFirstChildWhichIsA(
			"BasePart",
			true
		)

		if part then
			return part
		end
	end

	local droppedGun =
		Workspace:FindFirstChild("DroppedGun", true)

	if droppedGun then
		if droppedGun:IsA("BasePart") then
			return droppedGun
		end

		local part = droppedGun:FindFirstChildWhichIsA(
			"BasePart",
			true
		)

		if part then
			return part
		end
	end

	return nil
end

--==================================================
-- COINS
--==================================================

local function findCoinContainer()
	local container =
		Workspace:FindFirstChild("CoinContainer", true)

	if container then
		return container
	end

	return Workspace:FindFirstChild("Coins", true)
end

local function getCoinPickupPart(coin)
	if not coin then
		return nil
	end

	if coin:IsA("BasePart") then
		if coin:FindFirstChild("TouchInterest") then
			return coin
		end
	end

	local visual =
		coin:FindFirstChild("CoinVisual", true)

	if visual and visual:IsA("BasePart") then
		if visual:FindFirstChild("TouchInterest") then
			return visual
		end
	end

	for _, object in ipairs(coin:GetDescendants()) do
		if object:IsA("BasePart") then
			if object:FindFirstChild("TouchInterest") then
				return object
			end
		end
	end

	return nil
end

local function isCoinActive(coin)
	if not coin or not coin.Parent then
		return false
	end

	local visual =
		coin:FindFirstChild("CoinVisual", true)

	if visual and visual:IsA("BasePart") then
		if visual.Transparency >= 0.99 then
			return false
		end
	end

	return true
end

local function findNearestCoin(rootPart)
	local container = findCoinContainer()

	if not container or not rootPart then
		return nil, nil
	end

	local nearestPart = nil
	local nearestDistance = math.huge

	for _, coin in ipairs(container:GetChildren()) do
		if isCoinActive(coin) then

			local pickupPart =
				getCoinPickupPart(coin)

			if pickupPart and pickupPart.Parent then

				local distance =
					(rootPart.Position - pickupPart.Position).Magnitude

				if distance < nearestDistance then
					nearestDistance = distance
					nearestPart = pickupPart
				end
			end
		end
	end

	return nearestPart, nearestDistance
end

--==================================================
-- MOVE TO PICKUP
--==================================================

local function moveToPickup(rootPart, targetPart)
	if not rootPart or not targetPart then
		return false
	end

	if not targetPart.Parent then
		return false
	end

	pcall(function()
		rootPart.AssemblyLinearVelocity =
			Vector3.zero

		rootPart.AssemblyAngularVelocity =
			Vector3.zero
	end)

	rootPart.CFrame =
		targetPart.CFrame

	task.wait(0.03)

	fireTouch(
		rootPart,
		targetPart
	)

	return true
end

