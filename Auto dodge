-- Jujutsu Shenanigans: Predictive Auto-Dodge + Ghost Trail FX
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer

-- Настройки
local DodgeDistance = 12
local DodgeCooldown = 0.3
local lastDodgeTime = 0

-- Функция создания призрачного следа (Ghost Trail)
local function createGhostTrail(character)
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end

    -- Создаем несколько клонов с задержкой для красивого шлейфа
    for i = 1, 3 do
        task.spawn(function()
            task.wait(i * 0.04)
            if not character or not humanoidRootPart then return end
            
            -- Отключаем лишнее для оптимизации
            character.Archivable = true
            local clone = character:Clone()
            character.Archivable = false
            
            clone.Parent = workspace
            
            -- Удаляем скрипты и гуманоид из клона, оставляя только модель/меши
            for _, child in ipairs(clone:GetDescendants()) do
                if child:IsA("Script") or child:IsA("LocalScript") or child:IsA("Humanoid") then
                    child:Destroy()
                elseif child:IsA("BasePart") then
                    child.Anchored = true
                    child.CanCollide = false
                    child.Material = Enum.Material.Neon
                    child.Color = Color3.fromRGB(120, 200, 255) -- Неоново-голубой оттенок призрака
                    
                    -- Анимация растворения
                    TweenService:Create(child, TweenInfo.new(0.25), {
                        Transparency = 1,
                        Size = child.Size * 0.95
                    }):Play()
                end
            end
            
            -- Уничтожаем клона после анимации
            task.delay(0.3, function()
                if clone then clone:Destroy() end
            end)
        end)
    end
end

-- Функция выполнения стильного уклонения
local function performDodge(character, directionType)
    local currentTime = tick()
    if currentTime - lastDodgeTime < DodgeCooldown then return end
    lastDodgeTime = currentTime

    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    -- Определяем вектор ухода в зависимости от типа атаки
    local dodgeVector = Vector3.new(0, 0, 0)
    if directionType == "side" then
        -- Случайный выбор: влево или вправо (перпендикулярно)
        local sideSign = math.random(0, 1) == 1 and 1 or -1
        dodgeVector = rootPart.CFrame.RightVector * (DodgeDistance * sideSign)
    elseif directionType == "back" then
        -- Отпрыг назад
        dodgeVector = -rootPart.CFrame.LookVector * DodgeDistance
    end

    -- Запускаем визуальный эффект тени
    createGhostTrail(character)

    -- Плавный и быстрый телепорт/рывок с помощью TweenService
    local targetCFrame = rootPart.CFrame + dodgeVector
    local tweenInfo = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = targetCFrame})
    
    tween:Play()
end

