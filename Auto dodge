	MenuVisible = true,
	DodgeCount = 0,
	IsDashing = false,
}

local DodgeDistance = 14
local DodgeCooldown = 0.4
local lastDodgeTime = 0
local ENEMY_DASH_SPEED_THRESHOLD = 32
local TRIGGER_RANGE = 15

