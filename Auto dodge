--==================================================
-- ВИЗУАЛЬНЫЙ ЭФФЕКТ: GHOST TRAIL (ПРИЗРАЧНАЯ ТЕНЬ)
--==================================================

local function createGhostTrail(character)
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return end

	for i = 1, 3 do
		task.spawn(function()
			task.wait(i * 0.03)
			if not character or not rootPart.Parent then return end

			character.Archivable = true
			local clone = character:Clone()
			character.Archivable = false
			clone.Parent = workspace

			for _, child in ipairs(clone:GetDescendants()) do
				if child:IsA("Script") or child:IsA("LocalScript") or child:IsA("Humanoid") then
					child:Destroy()
				elseif child:IsA("BasePart") then
					child.Anchored = true
					child.CanCollide = false
					child.Material = Enum.Material.Neon
					child.Color = Color3.fromRGB(0, 180, 255) -- Яркий кибер-неон
					TweenService:Create(child, TweenInfo.new(0.2), {
						Transparency = 1,
						Size = child.Size * 0.9
					}):Play()
				end
			end

			task.delay(0.25, function()
				if clone then clone:Destroy() end
			end)
		end)
	end
end

--==================================================
-- ЛОГИКА УКЛОНЕНИЯ
--==================================================

local function performAutoDodge()
	local currentTime = tick()
	if currentTime - lastDodgeTime < DodgeCooldown or State.IsDashing then return end
	lastDodgeTime = currentTime
	State.IsDashing = true

	local character = LocalPlayer.Character
	if not character then State.IsDashing = false return end
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart then State.IsDashing = false return end

	-- Вычисляем вектор смещения
	local dodgeVector = Vector3.new(0, 0, 0)
	if State.DodgeMode == "side" then
		local randomSign = math.random(1, 2) == 1 and 1 or -1
		dodgeVector = rootPart.CFrame.RightVector * (DodgeDistance * randomSign)
	else
		dodgeVector = -rootPart.CFrame.LookVector * DodgeDistance
	end

	-- Запускаем тень-призрак
	createGhostTrail(character)

	-- Плавный твин-рывок
	local targetCFrame = rootPart.CFrame + dodgeVector
	local tweenInfo = TweenInfo.new(0.1, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)
	local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = targetCFrame})
	
	tween:Play()
	tween.Completed:Connect(function()
		State.IsDashing = false
	end)

	State.DodgeCount += 1
	updateUI()
end

--==================================================
-- СКАНИРОВАНИЕ ВРАГОВ (ПРЕДСКАЗАНИЕ РЫВКОВ)
--==================================================

RunService.RenderStepped:Connect(function()
	if not State.AutoDodgeEnabled or State.IsDashing then return end

	local character = LocalPlayer.Character
	if not character then return end
	local myRoot = character:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local enemyRoot = player.Character:FindFirstChild("HumanoidRootPart")
			local enemyHumanoid = player.Character:FindFirstChildOfClass("Humanoid")

			if enemyRoot and enemyHumanoid and enemyHumanoid.Health > 0 then
				local dist = (myRoot.Position - enemyRoot.Position).Magnitude
				if dist <= TRIGGER_RANGE then
					local enemyVel = enemyRoot.AssemblyLinearVelocity
					local flatVel = Vector3.new(enemyVel.X, 0, enemyVel.Z)

					-- Если враг делает резкий скачок/рывок в нашу сторону
					if flatVel.Magnitude >= ENEMY_DASH_SPEED_THRESHOLD then
						local dirToMe = (myRoot.Position - enemyRoot.Position).Unit
						local enemyDir = flatVel.Unit
						if enemyDir:Dot(dirToMe) > 0.35 then
							performAutoDodge()
							break
						end
					end
				end
			end
		end
	end
end)

--==================================================
-- КНОПКИ И УПРАВЛЕНИЕ
--==================================================

toggleBtn.MouseButton1Click:Connect(function()
	State.AutoDodgeEnabled = not State.AutoDodgeEnabled
	updateUI()
end)

modeBtn.MouseButton1Click:Connect(function()
	if State.DodgeMode == "side" then
		State.DodgeMode = "back"
	else
		State.DodgeMode = "side"
	end
	updateUI()
end)

UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.K then
		State.MenuVisible = not State.MenuVisible
		mainFrame.Visible = State.MenuVisible
	end
end)

